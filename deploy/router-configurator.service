[Unit]
Description=Router Configurator HTTP service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=router-configurator
Group=router-configurator
WorkingDirectory=/opt/router-configurator
ExecStart=/opt/router-configurator/.venv/bin/python -m router_configurator --env-file /etc/router-configurator/router-configurator.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=900
KillSignal=SIGTERM
KillMode=control-group
StateDirectory=router-configurator
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/router-configurator

[Install]
WantedBy=multi-user.target
